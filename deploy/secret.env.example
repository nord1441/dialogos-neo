# /etc/chatapp/secret.env  (chmod 0600, owned by chatapp:chatapp)
# Loaded by the systemd unit via EnvironmentFile=.

# Token required for /api/* automation routes.
# Generate with:  openssl rand -hex 32
API_TOKEN=replace-me

# Per-key env vars. Profile.toml refers to these via [api] key_ref = "anthropic_main".
API_KEY_ANTHROPIC_MAIN=sk-ant-...
# API_KEY_OPENAI_PERSONAL=sk-...
